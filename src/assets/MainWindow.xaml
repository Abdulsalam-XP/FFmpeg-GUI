<!-- src/assets/MainWindow.xaml -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg GUI" Height="760" Width="1180" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushShellBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Gradient-mesh background: four soft blurred corner glows over the base
             fill, per the "Midnight Gold" spec, so empty space still reads as having
             depth instead of a flat fill. Behind everything, never hit-test visible.
             Spans both columns so the glow isn't clipped to the sidebar's column. -->
        <Grid IsHitTestVisible="False" Grid.ColumnSpan="2">
            <Ellipse Width="620" Height="620" Fill="{StaticResource BrushGlowGold}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-220,0,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="640" Height="640" Fill="{StaticResource BrushGlowNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="600" Height="600" Fill="{StaticResource BrushGlowPlum}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="680" Height="680" Fill="{StaticResource BrushGlowDeepNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#8C060914">
            <Border BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="0,0,1,0" Opacity="0.5"
                    HorizontalAlignment="Right" Width="1"/>
            <TextBlock Text="FFMPEG GUI" FontFamily="{StaticResource FontData}" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" Opacity="0.75"
                       Margin="24,22,0,0" VerticalAlignment="Top"/>
            <Canvas x:Name="PillCanvas">
                <!-- Width/Height/Top are placeholders; Show-Panel resizes and positions
                     the pill from the selected nav item's measured bounds. Left matches
                     the nav StackPanel's horizontal margin. -->
                <Border x:Name="NavPill" Width="196" Height="40" CornerRadius="9"
                        Background="{StaticResource BrushAccentGradient}"
                        Canvas.Left="12" Canvas.Top="60">
                    <Border.Effect><DropShadowEffect Color="#D3A24C" Opacity="0.4" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
                </Border>
            </Canvas>
            <StackPanel x:Name="NavList" Margin="12,60,12,0">
                <RadioButton x:Name="NavCompress" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Compress">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconCompress}"/>
                        <TextBlock Text="Compress" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMergeAudio" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="MergeAudio">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconMergeAudio}"/>
                        <TextBlock Text="Merge Audio" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTrim" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Trim">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconTrim}"/>
                        <TextBlock Text="Trim" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP3" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP3">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconVideo}"/>
                        <TextBlock Text="YouTube MP3" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP4" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP4">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconVideo}"/>
                        <TextBlock Text="YouTube MP4" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <Border Height="1" Background="{StaticResource BrushBorderGold}" Opacity="0.45" Margin="16,14,16,14"/>
                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <Button x:Name="NavConvertMp4" Style="{StaticResource SidebarItemDisabledStyle}" IsEnabled="False" Margin="0,6,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Convert to MP4" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="SOON" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontData}" FontSize="9" Foreground="#4A4F68"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="48,40,48,40">
            <Grid x:Name="PanelCompress" Visibility="Visible">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Compress Video" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock x:Name="TextCompressMeta" Text="No file selected" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <Button x:Name="ButtonCompressBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="10"
                                    Background="#1A2340" BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#8593;" FontSize="18" Foreground="{StaticResource BrushGoldValue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse&#8230;" FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Drop a video here, or browse your files" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="MP4 &#183; MKV &#183; MOV &#8212; presets below adjust once a file loads" FontSize="12"
                                           Foreground="{StaticResource BrushTextBody}" FontFamily="{StaticResource FontChrome}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="PRESET" FontSize="10.5" FontFamily="{StaticResource FontChrome}"
                               Foreground="{StaticResource BrushTextMuted}" Opacity="0.8" Margin="2,0,0,10"/>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- TextEstSize* stay at an em dash until a file is loaded; Task 10
                             fills them from Get-CompressionSuggestions. -->
                        <RadioButton x:Name="ButtonPresetHigh" Grid.Column="0" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="High Quality" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Visually lossless. Best for archival or re-editing later." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Est. size" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextEstSizeHigh" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetBalanced" Grid.Column="2" GroupName="CompressPreset" IsChecked="True"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Balanced" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Sensible default &#8212; small size loss most people never notice." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Est. size" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextEstSizeBalanced" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetSmall" Grid.Column="4" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Small Size" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Aggressive compression for sharing or slow connections." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Est. size" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextEstSizeSmall" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarCompress" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextCompressPercent" Text="0.0%" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextCompressEta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonCompressCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelMergeAudio" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Merge Audio Streams" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock x:Name="TextMergeMeta" Text="No file selected" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <Button x:Name="ButtonMergeBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="10"
                                    Background="#1A2340" BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#8593;" FontSize="18" Foreground="{StaticResource BrushGoldValue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse&#8230;" FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Drop a multi-stream video here, or browse your files" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="System and mic audio streams get mixed into one track" FontSize="12"
                                           Foreground="{StaticResource BrushTextBody}" FontFamily="{StaticResource FontChrome}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="System volume" Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ComboSystemVolume" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/><ComboBoxItem Content="3.5x"/><ComboBoxItem Content="5.0x"/>
                            </ComboBox>
                            <TextBlock Text="Mic volume" Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center" Margin="24,0,10,0"/>
                            <ComboBox x:Name="ComboMicVolume" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/><ComboBoxItem Content="3.5x"/><ComboBoxItem Content="5.0x"/>
                            </ComboBox>
                            <Button x:Name="ButtonMergeStart" Content="Merge" Style="{StaticResource PresetButtonStyle}" Width="120" Margin="28,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarMerge" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextMergePercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextMergeEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonMergeCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelTrim" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Trim Video" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock x:Name="TextTrimMeta" Text="No file selected" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <Button x:Name="ButtonTrimBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="10"
                                    Background="#1A2340" BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#8593;" FontSize="18" Foreground="{StaticResource BrushGoldValue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse&#8230;" FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Drop a video here, or browse your files" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="Cut everything before or after a timestamp, no re-encode" FontSize="12"
                                           Foreground="{StaticResource BrushTextBody}" FontFamily="{StaticResource FontChrome}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton x:Name="RadioTrimBefore" Content="Remove content BEFORE timestamp" GroupName="TrimMode" IsChecked="True"
                                             Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" Margin="0,0,24,0"/>
                                <RadioButton x:Name="RadioTrimAfter" Content="Remove content AFTER timestamp" GroupName="TrimMode"
                                             Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TextTrimTimestamp" Width="140" Padding="8,6" HorizontalAlignment="Left" FontFamily="{StaticResource FontData}" Text="00:00:00"/>
                                <Button x:Name="ButtonTrimStart" Content="Trim" Style="{StaticResource PresetButtonStyle}" Width="120" Margin="16,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarTrim" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextTrimPercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextTrimEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonTrimCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelYouTubeMP3" Visibility="Collapsed"/>
            <Grid x:Name="PanelYouTubeMP4" Visibility="Collapsed"/>
            <Grid x:Name="PanelSettings" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
