<!-- src/assets/MainWindow.xaml -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg GUI" Height="760" Width="1180" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushShellBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Gradient-mesh background: four soft blurred corner glows over the base
             fill, per the "Midnight Gold" spec, so empty space still reads as having
             depth instead of a flat fill. Behind everything, never hit-test visible.
             Spans both columns so the glow isn't clipped to the sidebar's column. -->
        <Grid IsHitTestVisible="False" Grid.ColumnSpan="2">
            <Ellipse Width="620" Height="620" Fill="{StaticResource BrushGlowGold}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-220,0,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="640" Height="640" Fill="{StaticResource BrushGlowNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="600" Height="600" Fill="{StaticResource BrushGlowPlum}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="680" Height="680" Fill="{StaticResource BrushGlowDeepNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#8C060914">
            <Border BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="0,0,1,0" Opacity="0.5"
                    HorizontalAlignment="Right" Width="1"/>
            <TextBlock Text="FFMPEG GUI" FontFamily="{StaticResource FontData}" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" Opacity="0.75"
                       Margin="24,22,0,0" VerticalAlignment="Top"/>
            <Canvas x:Name="PillCanvas">
                <!-- Width/Height/Top are placeholders; Show-Panel resizes and positions
                     the pill from the selected nav item's measured bounds. Left matches
                     the nav StackPanel's horizontal margin. -->
                <Border x:Name="NavPill" Width="196" Height="40" CornerRadius="9"
                        Background="{StaticResource BrushAccentGradient}"
                        Canvas.Left="12" Canvas.Top="60">
                    <Border.Effect><DropShadowEffect Color="#D3A24C" Opacity="0.4" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
                </Border>
            </Canvas>
            <StackPanel x:Name="NavList" Margin="12,60,12,0">
                <RadioButton x:Name="NavCompress" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Compress">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconCompress}"/>
                        <TextBlock Text="Compress" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMergeAudio" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="MergeAudio">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconMixer}"/>
                        <TextBlock Text="Merge Audio" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTrim" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Trim">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconTrim}"/>
                        <TextBlock Text="Trim" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP3" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP3">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconMergeAudio}"/>
                        <TextBlock Text="YouTube MP3" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP4" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP4">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconVideo}"/>
                        <TextBlock Text="YouTube MP4" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <Button x:Name="NavConvertMp4" Style="{StaticResource SidebarItemDisabledStyle}" IsEnabled="False" Margin="0,6,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Convert to MP4" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="SOON" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontData}" FontSize="9" Foreground="#4A4F68"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content. Scrollable because a panel can outgrow the window: the Compress
             screen gains a whole card when an NVIDIA GPU is present, and the window is
             resizable down to MinHeight. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,40,40,40" Background="Transparent">
        <Grid>
            <Grid x:Name="PanelCompress" Visibility="Visible">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Compress Video" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonCompressBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextCompressDropCaption" Text="Drag and drop your video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="MP4 &#183; MKV &#183; MOV" FontSize="11.5" FontFamily="{StaticResource FontData}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Error text for an unreadable file still needs somewhere to go; it
                         reuses this block, which is why it is not inside the card. -->
                    <TextBlock x:Name="TextCompressMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <ContentControl x:Name="CardCompressVideo" Style="{StaticResource VideoCardStyle}"
                                    Visibility="Collapsed" Margin="0,0,0,26"/>

                    <!-- Shown only when an NVIDIA card is detected, matching the console
                         version, which offered the NVENC choice on those machines only. -->
                    <Border x:Name="CardGpuMode" Style="{StaticResource OptionCardBorderStyle}"
                            Margin="0,0,0,26" Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TextGpuName" Text="NVIDIA GPU detected" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#1A3FCF7F" BorderBrush="#5C4FD67F" BorderThickness="1"
                                            CornerRadius="9" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#4FD67F" VerticalAlignment="Center"/>
                                            <TextBlock Text="DETECTED" FontSize="9.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                                       Foreground="#7FE0A4" FontFamily="{StaticResource FontChrome}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Encode with NVENC: far faster, slightly larger files than CPU at the same quality."
                                           FontSize="12" Foreground="{StaticResource BrushTextBody}" FontFamily="{StaticResource FontChrome}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="ToggleGpuMode" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="PRESET" FontSize="10.5" FontFamily="{StaticResource FontChrome}"
                               Foreground="{StaticResource BrushTextMuted}" Opacity="0.8" Margin="2,0,0,10"/>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- The detail line shows the encoder settings the preset will
                             actually use, filled by Get-CompressionPresetDetails and
                             refreshed when the GPU toggle changes the codec. -->
                        <RadioButton x:Name="ButtonPresetHigh" Grid.Column="0" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="High Quality" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Visually lossless. Best for archival or re-editing later." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailHigh" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetBalanced" Grid.Column="2" GroupName="CompressPreset" IsChecked="True"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Balanced" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Sensible default &#8212; small size loss most people never notice." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailBalanced" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetSmall" Grid.Column="4" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Small Size" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Aggressive compression for sharing or slow connections." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailSmall" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>

                        <!-- The selected-preset outline, drawn once and slid between cards
                             by Move-PresetHighlight. Last child and spanning every column
                             so it paints OVER the cards: their backgrounds are opaque, and
                             an outline underneath them would simply be hidden. -->
                        <Border x:Name="PresetTravel" Grid.Column="0" Grid.ColumnSpan="5"
                                CornerRadius="11" BorderThickness="1.4"
                                BorderBrush="{StaticResource BrushAccentGradient}"
                                Background="Transparent" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Width="0" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PresetTravelShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Selecting a preset only selects it; starting a multi-minute encode
                         is a separate, deliberate action. -->
                    <Button x:Name="ButtonCompressStart" Content="Compress" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,0,0,26" IsEnabled="False"/>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarCompress" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextCompressPercent" Text="0.0%" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextCompressEta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonCompressCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelMergeAudio" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Merge Audio Streams" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonMergeBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextMergeDropCaption" Text="Drag and drop a multi-stream video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="System and mic audio get mixed into one track" FontSize="11.5" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="TextMergeMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <ContentControl x:Name="CardMergeVideo" Style="{StaticResource VideoCardStyle}"
                                    Visibility="Collapsed" Margin="0,0,0,26"/>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="System volume" Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ComboSystemVolume" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/><ComboBoxItem Content="3.5x"/><ComboBoxItem Content="5.0x"/>
                            </ComboBox>
                            <TextBlock Text="Mic volume" Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center" Margin="24,0,10,0"/>
                            <ComboBox x:Name="ComboMicVolume" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/><ComboBoxItem Content="3.5x"/><ComboBoxItem Content="5.0x"/>
                            </ComboBox>
                            <Button x:Name="ButtonMergeStart" Content="Merge" Style="{StaticResource PresetButtonStyle}" Width="120" Margin="28,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarMerge" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextMergePercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextMergeEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonMergeCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelTrim" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Trim Video" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonTrimBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextTrimDropCaption" Text="Drag and drop your video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="Cut before or after a timestamp, no re-encode" FontSize="11.5" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="TextTrimMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <ContentControl x:Name="CardTrimVideo" Style="{StaticResource VideoCardStyle}"
                                    Visibility="Collapsed" Margin="0,0,0,26"/>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton x:Name="RadioTrimBefore" Content="Remove content BEFORE timestamp" GroupName="TrimMode" IsChecked="True"
                                             Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5" Margin="0,0,24,0"/>
                                <RadioButton x:Name="RadioTrimAfter" Content="Remove content AFTER timestamp" GroupName="TrimMode"
                                             Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TextTrimTimestamp" Width="140" Padding="8,6" HorizontalAlignment="Left" FontFamily="{StaticResource FontData}" Text="00:00:00"/>
                                <Button x:Name="ButtonTrimStart" Content="Trim" Style="{StaticResource PresetButtonStyle}" Width="120" Margin="16,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarTrim" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextTrimPercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextTrimEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonTrimCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelYouTubeMP3" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="YouTube MP3" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Audio is extracted to MP3 and saved in the MP3 Downloads folder" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="VIDEO URL" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP3Start" DockPanel.Dock="Right" Content="Download"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0"/>
                            <TextBox x:Name="TextYoutubeMP3Url" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarYoutubeMP3" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextYoutubeMP3Status" Text="Waiting for a link" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextYoutubeMP3Eta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonYoutubeMP3Cancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelYouTubeMP4" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="YouTube MP4" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Videos are saved in the MP4 Downloads folder" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="VIDEO URL" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,20">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP4Fetch" DockPanel.Dock="Right" Content="Find qualities"
                                    Style="{StaticResource PresetButtonStyle}" Padding="18,11" Margin="14,0,0,0"/>
                            <TextBox x:Name="TextYoutubeMP4Url" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="QUALITY" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP4Start" DockPanel.Dock="Right" Content="Download"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0" IsEnabled="False"/>
                            <!-- Populated by Find qualities; only the resolutions the video
                                 actually offers are listed. -->
                            <ComboBox x:Name="ComboYoutubeMP4Quality" Width="240" HorizontalAlignment="Left"
                                      IsEnabled="False"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarYoutubeMP4" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextYoutubeMP4Status" Text="Waiting for a link" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextYoutubeMP4Eta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonYoutubeMP4Cancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelSettings" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Preferences are saved to assets/settings.json" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Animations" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="The sliding nav highlight, hover effects and the drifting dropzone glow."
                                           FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           FontFamily="{StaticResource FontChrome}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="480"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="CheckShowAnimations" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" IsChecked="True"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="TOOLS" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}">
                        <!-- IsSharedSizeScope keeps the name/version/action columns aligned across the
                             three independent row Grids, whatever length version string a tool reports. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="ffmpeg and yt-dlp do the actual work. Keeping yt-dlp current is what stops YouTube links from failing."
                                       FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                       FontFamily="{StaticResource FontChrome}" TextWrapping="Wrap"
                                       Margin="0,0,0,18" MaxWidth="560" HorizontalAlignment="Left"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolVersion"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ffmpeg" VerticalAlignment="Center" MinWidth="76"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextBody}"/>
                                <TextBlock Grid.Column="1" x:Name="TextToolVersionFfmpeg" Text="&#8212;"
                                           VerticalAlignment="Center" MinWidth="150" MaxWidth="260" Margin="0,0,18,0"
                                           FontFamily="{StaticResource FontData}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" x:Name="ButtonUpdateFfmpeg" Content="Checking&#8230;"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="164" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" x:Name="TextToolPathFfmpeg" Text="&#8212;"
                                           VerticalAlignment="Center" Margin="22,0,0,0"
                                           HorizontalAlignment="Left" MaxWidth="430"
                                           FontFamily="{StaticResource FontData}" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolVersion"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ffprobe" VerticalAlignment="Center" MinWidth="76"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextBody}"/>
                                <TextBlock Grid.Column="1" x:Name="TextToolVersionFfprobe" Text="&#8212;"
                                           VerticalAlignment="Center" MinWidth="150" MaxWidth="260" Margin="0,0,18,0"
                                           FontFamily="{StaticResource FontData}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- No button by design: ffprobe is extracted from the same archive, so the
                                     ffmpeg button updates both. The label says so rather than leaving a gap. -->
                                <TextBlock Grid.Column="2" Text="ships with ffmpeg" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource FontChrome}" FontSize="11" FontStyle="Italic"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Grid.Column="3" x:Name="TextToolPathFfprobe" Text="&#8212;"
                                           VerticalAlignment="Center" Margin="22,0,0,0"
                                           HorizontalAlignment="Left" MaxWidth="430"
                                           FontFamily="{StaticResource FontData}" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolVersion"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="yt-dlp" VerticalAlignment="Center" MinWidth="76"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextBody}"/>
                                <TextBlock Grid.Column="1" x:Name="TextToolVersionYtDlp" Text="&#8212;"
                                           VerticalAlignment="Center" MinWidth="150" MaxWidth="260" Margin="0,0,18,0"
                                           FontFamily="{StaticResource FontData}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" x:Name="ButtonUpdateYtDlp" Content="Checking&#8230;"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="164" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" x:Name="TextToolPathYtDlp" Text="&#8212;"
                                           VerticalAlignment="Center" Margin="22,0,0,0"
                                           HorizontalAlignment="Left" MaxWidth="430"
                                           FontFamily="{StaticResource FontData}" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Grid>

                            <ProgressBar x:Name="ProgressBarTools" Style="{StaticResource ProgressBarStyle}"
                                         Margin="0,18,0,0" Value="0" Visibility="Collapsed"/>
                            <Button x:Name="ButtonToolsCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,12,0,0"
                                    Visibility="Collapsed" IsEnabled="False"/>
                            <TextBlock x:Name="TextToolsStatus" Text="" FontSize="11.5" Margin="0,12,0,0"
                                       FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
