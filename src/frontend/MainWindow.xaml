<!-- src/assets/MainWindow.xaml -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg GUI" Height="1300" Width="1860" MinHeight="640" MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushShellBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Gradient-mesh background: four soft blurred corner glows over the base
             fill, per the "Midnight Gold" spec, so empty space still reads as having
             depth instead of a flat fill. Behind everything, never hit-test visible.
             Spans both columns so the glow isn't clipped to the sidebar's column. -->
        <Grid x:Name="GridBackgroundGlows" IsHitTestVisible="False" Grid.ColumnSpan="2">
            <Ellipse Width="620" Height="620" Fill="{StaticResource BrushGlowGold}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-220,0,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="640" Height="640" Fill="{StaticResource BrushGlowNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="600" Height="600" Fill="{StaticResource BrushGlowPlum}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="680" Height="680" Fill="{StaticResource BrushGlowDeepNavy}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-260">
                <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- Petalfall look only: falling petals, drawn from code onto this layer. ZIndex
             puts them OVER the whole window; the approved mockup drifts petals across
             panels and preview alike, and hit-testing stays off so they never eat a click. -->
        <Canvas x:Name="CanvasLookPetals" Grid.ColumnSpan="2" Panel.ZIndex="50"
                IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#8C060914">
            <Border BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="0,0,1,0" Opacity="0.5"
                    HorizontalAlignment="Right" Width="1"/>
            <TextBlock Text="FFMPEG GUI" FontFamily="{StaticResource FontData}" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" Opacity="0.75"
                       Margin="24,22,0,0" VerticalAlignment="Top"/>
            <Canvas x:Name="PillCanvas">
                <!-- Width/Height/Top are placeholders; Show-Panel resizes and positions
                     the pill from the selected nav item's measured bounds. Left matches
                     the nav StackPanel's horizontal margin. -->
                <Border x:Name="NavPill" Width="196" Height="40" CornerRadius="9"
                        Background="{StaticResource BrushAccentGradient}"
                        Canvas.Left="12" Canvas.Top="60">
                    <Border.Effect><DropShadowEffect Color="#D3A24C" Opacity="0.4" BlurRadius="18" ShadowDepth="4"/></Border.Effect>
                </Border>
            </Canvas>
            <StackPanel x:Name="NavList" Margin="12,60,12,0">
                <RadioButton x:Name="NavCompress" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Compress">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconCompress}"/>
                        <TextBlock Text="Compress" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMergeAudio" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="MergeAudio">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconMixer}"/>
                        <TextBlock Text="Merge Audio" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTrim" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Trim">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconTrim}"/>
                        <TextBlock Text="Video Editor" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP3" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP3">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconMergeAudio}"/>
                        <TextBlock Text="YouTube MP3" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavYouTubeMP4" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="YouTubeMP4">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconVideo}"/>
                        <TextBlock Text="YouTube MP4" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SidebarItemStyle}" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <Button x:Name="NavConvertMp4" Style="{StaticResource SidebarItemDisabledStyle}" IsEnabled="False" Margin="0,6,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Convert to MP4" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="SOON" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontData}" FontSize="9" Foreground="#4A4F68"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content. Scrollable because a panel can outgrow the window: the Compress
             screen gains a whole card when an NVIDIA GPU is present, and the window is
             resizable down to MinHeight. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,40,40,40" Background="Transparent">
        <Grid>
            <Grid x:Name="PanelCompress" Visibility="Visible">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Compress Video" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonCompressBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextCompressDropCaption" Text="Drag and drop your video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="MP4 &#183; MKV &#183; MOV" FontSize="11.5" FontFamily="{StaticResource FontData}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Border x:Name="CardRecentCompress" Style="{StaticResource RecentCardStyle}"
                            Visibility="Collapsed" Margin="0,0,0,26">
                        <StackPanel>
                            <TextBlock Text="OR PICK A RECENT FILE" Style="{StaticResource RecentLabelStyle}"/>
                            <StackPanel x:Name="PanelRecentCompress"/>
                        </StackPanel>
                    </Border>

                    <!-- Error text for an unreadable file still needs somewhere to go; it
                         reuses this block, which is why it is not inside the card. -->
                    <TextBlock x:Name="TextCompressMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <ContentControl x:Name="CardCompressVideo" Style="{StaticResource VideoCardStyle}"
                                    Visibility="Collapsed" Margin="0,0,0,26"/>

                    <!-- Shown only when an NVIDIA card is detected, matching the console
                         version, which offered the NVENC choice on those machines only. -->
                    <Border x:Name="CardGpuMode" Style="{StaticResource OptionCardBorderStyle}"
                            Margin="0,0,0,26" Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TextGpuName" Text="NVIDIA GPU detected" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#1A3FCF7F" BorderBrush="#5C4FD67F" BorderThickness="1"
                                            CornerRadius="9" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#4FD67F" VerticalAlignment="Center"/>
                                            <TextBlock Text="DETECTED" FontSize="9.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                                       Foreground="#7FE0A4" FontFamily="{StaticResource FontChrome}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Encode with NVENC: far faster, slightly larger files than CPU at the same quality."
                                           FontSize="12" Foreground="{StaticResource BrushTextBody}" FontFamily="{StaticResource FontChrome}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="ToggleGpuMode" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="PRESET" FontSize="10.5" FontFamily="{StaticResource FontChrome}"
                               Foreground="{StaticResource BrushTextMuted}" Opacity="0.8" Margin="2,0,0,10"/>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- The detail line shows the encoder settings the preset will
                             actually use, filled by Get-CompressionPresetDetails and
                             refreshed when the GPU toggle changes the codec. -->
                        <RadioButton x:Name="ButtonPresetHigh" Grid.Column="0" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="High Quality" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Visually lossless. Best for archival or re-editing later." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailHigh" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetBalanced" Grid.Column="2" GroupName="CompressPreset" IsChecked="True"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Balanced" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Sensible default &#8212; small size loss most people never notice." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailBalanced" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ButtonPresetSmall" Grid.Column="4" GroupName="CompressPreset"
                                     Style="{StaticResource PresetCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Small Size" FontFamily="{StaticResource FontChrome}" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Aggressive compression for sharing or slow connections." TextWrapping="Wrap"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           Margin="0,6,0,14" LineHeight="17"/>
                                <Grid>
                                    <TextBlock Text="Encoder" FontFamily="{StaticResource FontData}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TextPresetDetailSmall" Text="&#8212;" FontFamily="{StaticResource FontData}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </RadioButton>

                        <!-- The selected-preset outline, drawn once and slid between cards
                             by Move-PresetHighlight. Last child and spanning every column
                             so it paints OVER the cards: their backgrounds are opaque, and
                             an outline underneath them would simply be hidden. -->
                        <Border x:Name="PresetTravel" Grid.Column="0" Grid.ColumnSpan="5"
                                CornerRadius="11" BorderThickness="1.4"
                                BorderBrush="{StaticResource BrushAccentGradient}"
                                Background="Transparent" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Width="0" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PresetTravelShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Selecting a preset only selects it; starting a multi-minute encode
                         is a separate, deliberate action. -->
                    <Button x:Name="ButtonCompressStart" Content="Compress" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,0,0,26" IsEnabled="False"/>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarCompress" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextCompressPercent" Text="0.0%" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextCompressEta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonCompressCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelMergeAudio" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Merge Audio Streams" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonMergeBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextMergeDropCaption" Text="Drag and drop a multi-stream video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="System and mic audio get mixed into one track" FontSize="11.5" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Border x:Name="CardRecentMerge" Style="{StaticResource RecentCardStyle}"
                            Visibility="Collapsed" Margin="0,0,0,26">
                        <StackPanel>
                            <TextBlock Text="OR PICK A RECENT FILE" Style="{StaticResource RecentLabelStyle}"/>
                            <StackPanel x:Name="PanelRecentMerge"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TextMergeMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <ContentControl x:Name="CardMergeVideo" Style="{StaticResource VideoCardStyle}"
                                    Visibility="Collapsed" Margin="0,0,0,26"/>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <!-- Sliders rather than the old four-step "1x / 2x / 3.5x / 5x"
                             combos: those could only ever make a track LOUDER, and the
                             common case (game drowning out the mic, or the other way
                             round) needs one side pulled down. Measured in dB, the unit
                             gain is actually additive in, which also gives the scale a
                             natural centre at 0 = leave it alone. -->
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System volume" Grid.Column="0" Foreground="{StaticResource BrushTextMuted}"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderSystemVolume" Grid.Column="1" Style="{StaticResource GainSliderStyle}"/>
                                <TextBlock x:Name="TextSystemVolume" Grid.Column="2" Text="0.0 dB" TextAlignment="Right"
                                           Foreground="{StaticResource BrushGoldValue}" FontFamily="{StaticResource FontData}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mic volume" Grid.Column="0" Foreground="{StaticResource BrushTextMuted}"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderMicVolume" Grid.Column="1" Style="{StaticResource GainSliderStyle}"/>
                                <TextBlock x:Name="TextMicVolume" Grid.Column="2" Text="0.0 dB" TextAlignment="Right"
                                           Foreground="{StaticResource BrushGoldValue}" FontFamily="{StaticResource FontData}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="0 dB leaves a track untouched -- double-click a slider to reset it"
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontChrome}"
                                           FontSize="10.5" FontStyle="Italic" VerticalAlignment="Center"/>
                                <Button x:Name="ButtonMergeStart" Content="Merge" Style="{StaticResource PrimaryButtonStyle}"
                                        Width="120" Margin="28,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarMerge" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextMergePercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextMergeEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonMergeCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelTrim" Visibility="Collapsed">
                <!-- 1400, not the 880 the other panels use: this is an editor, not a form.
                     The preview, timeline, waveform and caption lane all scale with this,
                     and at 880 they read as miniature on a 2560-wide screen. -->
                <StackPanel MaxWidth="1560" HorizontalAlignment="Stretch">
                    <TextBlock Text="Video Editor" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>

                    <Button x:Name="ButtonTrimBrowse" Style="{StaticResource DropzoneButtonStyle}" Margin="0,18,0,26">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Style="{StaticResource DropCloudIconStyle}" Data="{StaticResource IconDropCloud}"/>
                            <TextBlock x:Name="TextTrimDropCaption" Text="Drag and drop your video here" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="Cut, fade and caption your video" FontSize="11.5" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="or" FontSize="12" FontFamily="{StaticResource FontChrome}"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource DropzoneChipStyle}">
                                <TextBlock Text="Browse Files" FontFamily="{StaticResource FontChrome}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFF8EC"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Border x:Name="CardRecentTrim" Style="{StaticResource RecentCardStyle}"
                            Visibility="Collapsed" Margin="0,0,0,26">
                        <StackPanel>
                            <TextBlock Text="OR PICK A RECENT FILE" Style="{StaticResource RecentLabelStyle}"/>
                            <StackPanel x:Name="PanelRecentTrim"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TextTrimMeta" Text="No file selected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}"
                               Margin="0,0,0,14"/>
                    <Border x:Name="CardTrimEditor" Style="{StaticResource CardBorderStyle}"
                            Visibility="Collapsed" Margin="0,0,0,26">
                        <StackPanel>
                            <!-- Height is set from code, not fixed here: the source is always
                                 16:9, so pinning a height independent of the card's actual width
                                 either letterboxes (box too wide) or crops (box too narrow).
                                 Driving it off ActualWidth keeps it exactly 16:9 and full-width. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Black, not transparent: with the Clip geometry set from code this
                                     paints only the video box, and at a zoomed-out keyframe the video
                                     shrinks inside that box, so what shows around it must match the
                                     export's pad color. -->
                                <Grid x:Name="PreviewCell" Grid.Column="0" ClipToBounds="True" Background="Black">
                                    <!-- The host and overlay are sized from code to the largest 16:9 box
                                         that fits BOTH the card width and the window height, so the whole
                                         editor (preview + timeline) stays on screen without scrolling.
                                         Deliberately NO wrapper element between the cell and the host: an
                                         intermediate sized grid was observed (live, 2026-08-11) to stop
                                         the zoom RenderTransform from reaching the screen entirely, so the
                                         zoom clip is a Clip geometry on this cell instead. -->
                                    <!-- Wraps only the two video surfaces: a zoom keyframe's scale/
                                         translate transform is applied to this host so the caption
                                         overlay below stays pinned to the frame instead of zooming
                                         with it. -->
                                    <Grid x:Name="PreviewZoomHost">
                                        <!-- Fill, not Uniform: the host is always sized to the video's own
                                             shape at identity, and at a stretched zoom keyframe the host IS
                                             the stretch; Uniform would letterbox inside it and undo the
                                             effect. -->
                                        <MediaElement x:Name="MediaTrimPreview" Stretch="Fill" HorizontalAlignment="Stretch"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"/>
                                        <!-- Plays a pre-rendered copy of one crossfade, on top of the
                                             main preview, while the playhead is inside that fade. A
                                             crossfade is two source positions blended at once, which a
                                             single decoder cannot produce, so the alternative to this
                                             overlay is showing a straight cut and hoping the export
                                             looks right. Silent by design: the element underneath keeps
                                             playing the real audio. -->
                                        <MediaElement x:Name="MediaTrimFadePreview" Stretch="Fill" HorizontalAlignment="Stretch"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                                      Volume="0" Visibility="Collapsed"/>
                                    </Grid>
                                    <!-- Captions render here, over the video, under the user's pointer. -->
                                    <Canvas x:Name="CanvasCaptionOverlay" Background="Transparent"/>
                                </Grid>
                                <Border x:Name="PanelCaptionSidebar" Grid.Column="1" Width="240" Visibility="Collapsed"
                                        Style="{StaticResource OptionCardBorderStyle}" Margin="14,0,0,0" Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="CAPTION" Style="{StaticResource SidebarLabelStyle}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TextCaptionText" AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap"/>
                                            <TextBlock Text="FONT" Style="{StaticResource SidebarLabelStyle}"/>
                                            <ComboBox x:Name="ComboCaptionFont"/>
                                            <CheckBox x:Name="CheckCaptionBold" Content="Bold" Margin="0,8,0,0"
                                                      Foreground="{StaticResource BrushTextBody}"/>
                                            <TextBlock Text="FILL COLOR (#RRGGBB)" Style="{StaticResource SidebarLabelStyle}"/>
                                            <!-- Swatch buttons are added from code at startup; the hex box below stays
                                                 the free entry route for any colour not in the palette. -->
                                            <WrapPanel x:Name="PanelCaptionFillSwatches" Margin="0,2,0,4"/>
                                            <TextBox x:Name="TextCaptionFill"/>
                                            <TextBlock Text="OUTLINE COLOR" Style="{StaticResource SidebarLabelStyle}"/>
                                            <WrapPanel x:Name="PanelCaptionOutlineSwatches" Margin="0,2,0,4"/>
                                            <TextBox x:Name="TextCaptionOutline"/>
                                            <TextBlock Text="OUTLINE WIDTH" Style="{StaticResource SidebarLabelStyle}"/>
                                            <Slider x:Name="SliderCaptionOutlineW" Minimum="0" Maximum="8" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True"/>
                                            <CheckBox x:Name="CheckCaptionBounce" Content="Bounce in" Margin="0,10,0,0"
                                                      Foreground="{StaticResource BrushTextBody}"/>
                                            <TextBlock Text="START / END (MM:SS.mmm)" Style="{StaticResource SidebarLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TextCaptionStart" Grid.Column="0"/>
                                                <TextBox x:Name="TextCaptionEnd" Grid.Column="2"/>
                                            </Grid>
                                            <Button x:Name="ButtonCaptionDelete" Content="Delete caption"
                                                    Style="{StaticResource PresetButtonStyle}" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,14">
                                <Button x:Name="ButtonTrimPlay" Content="Play" Style="{StaticResource PresetButtonStyle}" Width="90"/>
                                <TextBlock x:Name="TextTrimPosition" Text="00:00.000 / 00:00.000"
                                           FontFamily="{StaticResource FontData}" FontSize="13.5"
                                           Foreground="{StaticResource BrushGoldValue}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <!-- Replaces the huge dropzone once a file is loaded (the dropzone
                                     and the recent list collapse then, so the whole editor fits on
                                     screen without scrolling). -->
                                <Button x:Name="ButtonTrimOpenAnother" Content="Open another video"
                                        Style="{StaticResource PresetButtonStyle}" Visibility="Collapsed"
                                        Padding="12,4,12,4" Margin="28,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Filmstrip track. The dedicated waveform strip that used to sit in a
                                 second row here is gone: audio lane rows carry their own waveforms
                                 now (spec 3.1), so this is a single full height row.

                                 The 250px column in front of this row and every other timeline
                                 space row below (captions, zooms, ruler, fades) is the same header
                                 column the lane rows use: the mockup runs it down the whole stack
                                 so one playhead line crosses every row at the same x.
                                 Convert-TrimTimeToX measures CanvasTrimTimeline, so all of these
                                 have to share the inset or they stop agreeing. The ruler and fade
                                 rows take it as a plain Margin (the mockup leaves the ruler gutter
                                 empty); the three lanes with something to say fill it with a
                                 header cell. -->
                            <!-- Height 0 + clip, NOT removed: CanvasTrimTimeline is the x-axis
                                 authority for the whole editor (Convert-TrimTimeToX measures its
                                 ActualWidth), so it must stay laid out at full width even though
                                 the SRC filmstrip row no longer shows. V1's own lane row is the
                                 visible piece strip now, and scrubbing lives on the ruler. -->
                            <Grid Height="0" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="90" ClipToBounds="True">
                                    <Canvas x:Name="CanvasTrimTimeline" Background="Transparent"/>
                                </Border>
                            </Grid>

                            <!-- Track lanes: grouped NLE rows, code-built by Update-TrimLaneRows.
                                 CanvasTrimLaneOverlay carries the stack-spanning playhead line and
                                 the green snap flash, above every row. The add-track buttons sit
                                 UNDER the stack, aligned with the header column, where new lanes
                                 actually appear (moved out of the toolbar on the user's ask). -->
                            <Grid Margin="0,4,0,0">
                                <!-- Transparent Background + AllowDrop: files dropped on the OPEN
                                     area (between/below the rows) create a new track of the file's
                                     kind at the drop position; rows mark their own drops Handled
                                     so they still target that specific lane. -->
                                <StackPanel x:Name="PanelTrimLaneArea" Background="Transparent" AllowDrop="True">
                                    <StackPanel x:Name="PanelTrimTracks" Visibility="Collapsed"/>
                                    <StackPanel x:Name="PanelTrimAddTracks" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,4">
                                        <Button x:Name="ButtonTrimAddVideoTrack" Content="＋ Video track" Style="{StaticResource LaneAddButtonStyle}"/>
                                        <Button x:Name="ButtonTrimAddAudioTrack" Content="＋ Audio track" Style="{StaticResource LaneAddButtonStyle}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Canvas x:Name="CanvasTrimLaneOverlay" IsHitTestVisible="False" ClipToBounds="True"/>
                            </Grid>

                            <!-- Caption lane: one block per caption, drag to move, edge drag to retime. -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource LaneHeaderStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,7,0">
                                        <TextBlock Text="CC" Style="{StaticResource LaneNameStyle}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Captions" Style="{StaticResource LaneLabelStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TimelineTrackStyle}" Height="54" ClipToBounds="True">
                                    <Canvas x:Name="CanvasTrimCaptions" Background="Transparent"/>
                                </Border>
                            </Grid>

                            <!-- Zoom keyframe lane: diamonds mark keyframes, ramps show the
                                 transition between them. Drawn from code. -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource LaneHeaderStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,7,0">
                                        <TextBlock Text="Z" Style="{StaticResource LaneNameStyle}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Zoom" Style="{StaticResource LaneLabelStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TimelineTrackStyle}" Height="26" ClipToBounds="True">
                                    <Canvas x:Name="CanvasTrimZooms" Background="Transparent"/>
                                </Border>
                            </Grid>

                            <!-- 26, not 20: the ruler now also carries the playhead time
                                 badge, which sits below the ticks and is clipped at 20. -->
                            <Canvas x:Name="CanvasTrimRuler" Height="26" Margin="250,0,0,0" Background="Transparent" ClipToBounds="True"/>

                            <!-- The visible way to reach the montage/slack region on the right;
                                 Shift+wheel and Ctrl+wheel do the same with the pointer. Bound to
                                 the view window from code on every timeline repaint. -->
                            <ScrollBar x:Name="ScrollTrimView" Orientation="Horizontal"
                                       Style="{StaticResource TimelineScrollBarStyle}"
                                       Margin="250,2,0,0" Visibility="Collapsed"/>

                            <!-- One fade toggle per internal cut, drawn from code at the
                                 cut's x position. Its own row rather than pills sitting on
                                 the track: at a tight zoom two cuts can be a few pixels
                                 apart, and a toggle overlapping the footage would be both
                                 unreadable and impossible to hit. -->
                            <Canvas x:Name="CanvasTrimFades" Height="38" Margin="250,0,0,0" Background="Transparent" ClipToBounds="True"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="TextTrimPieces" Text="1 piece"
                                           FontFamily="{StaticResource FontData}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock x:Name="TextTrimSelection" Text="nothing selected"
                                           FontFamily="{StaticResource FontData}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}" Margin="16,0,0,0"/>
                                <TextBlock x:Name="TextTrimAccuracy" Text=""
                                           FontFamily="{StaticResource FontData}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}" Margin="16,0,0,0"/>
                                <TextBlock Text="ctrl + scroll to zoom" FontFamily="{StaticResource FontChrome}"
                                           FontSize="12.5" FontStyle="Italic"
                                           Foreground="{StaticResource BrushTextMuted}" Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- Fade length belongs to one cut at a time: the picker edits
                                 whichever fade was last clicked, named in TextTrimFadeScope
                                 so it never looks like a global setting. -->
                            <StackPanel x:Name="PanelTrimFadeLength" Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="FADE LENGTH" FontFamily="{StaticResource FontData}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextTrimFadeScope" Text="" FontFamily="{StaticResource FontData}"
                                           FontSize="12.5" Foreground="{StaticResource BrushGoldValue}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button x:Name="ButtonFade025" Content="0.25s" Style="{StaticResource FadeLengthButtonStyle}" Margin="12,0,0,0"/>
                                <Button x:Name="ButtonFade050" Content="0.5s" Style="{StaticResource FadeLengthButtonStyle}" Margin="6,0,0,0"/>
                                <Button x:Name="ButtonFade100" Content="1s" Style="{StaticResource FadeLengthButtonStyle}" Margin="6,0,0,0"/>
                                <TextBlock x:Name="TextTrimFadeNote" Text="" FontFamily="{StaticResource FontChrome}"
                                           FontSize="12" FontStyle="Italic" Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- CLIP properties strip: shown only while a clip is selected, the
                                 same on/off rule PanelTrimFadeLength uses for a selected cut.
                                 The gain slider, mute box and row trash that used to live here
                                 moved into the lane row headers (spec 3.2), where they belong to
                                 the row rather than to whichever clip was last clicked. What is
                                 left is the clip's own identity, its full-frame/box display mode
                                 and its delete. -->
                            <StackPanel x:Name="PanelTrimTrackProps" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Text="CLIP" FontFamily="{StaticResource FontData}" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextTrackPropsName" Text="" FontFamily="{StaticResource FontData}" FontSize="12.5" Foreground="{StaticResource BrushGoldValue}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button x:Name="ButtonClipDisplayMode" Content="⛶ Full-frame" Style="{StaticResource PresetButtonStyle}" Margin="16,0,0,0"/>
                                <TextBlock x:Name="TextClipDisplayHint" Text="" FontFamily="{StaticResource FontChrome}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Button x:Name="ButtonTrackDelete" Content="Delete clip" Style="{StaticResource PresetButtonStyle}" Margin="16,0,0,0"/>
                            </StackPanel>

                            <!-- DockPanel, not a StackPanel: Export is declared FIRST and docked
                                 Right, so it claims its space before the editing verbs do and can
                                 never be pushed off the card at narrow widths (the old fixed-width
                                 StackPanel clipped it). The add-track buttons live beside the lane
                                 stack now, not here. -->
                            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                <Button x:Name="ButtonTrimExport" DockPanel.Dock="Right" Content="Export Video"
                                        Style="{StaticResource HeroButtonStyle}"
                                        Width="170" Margin="40,0,0,0" IsEnabled="False"/>
                                <Button x:Name="ButtonTrimAddCaption" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="120">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="＋ Caption"/>
                                        <TextBlock Text="C" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimAddZoom" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="110" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="＋ Zoom"/>
                                        <TextBlock Text="Z" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimSnap" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="110" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TextTrimSnapGlyph" Text="🧲 Snap"/>
                                        <TextBlock Text="N" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimUnlink" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="150" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗 Unlink"/>
                                        <TextBlock Text="U" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimSplit" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="110" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Split"/>
                                        <TextBlock Text="S" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimDelete" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="120" Margin="12,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Delete"/>
                                        <TextBlock Text="DEL" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimUndo" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="130" Margin="12,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Undo"/>
                                        <TextBlock Text="Ctrl+Z" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ButtonTrimRedo" DockPanel.Dock="Left" Style="{StaticResource PresetButtonStyle}" Width="130" Margin="12,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Redo"/>
                                        <TextBlock Text="Ctrl+Y" Style="{StaticResource ShortcutHintStyle}"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarTrim" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextTrimPercent" Text="0.0%" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushGoldValue}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextTrimEta" Text="--:--:--" FontFamily="{StaticResource FontData}" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonTrimCancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}" HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelYouTubeMP3" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="YouTube MP3" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Audio is extracted to MP3 and saved in the MP3 Downloads folder" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="VIDEO URL" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP3Start" DockPanel.Dock="Right" Content="Download"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0"/>
                            <TextBox x:Name="TextYoutubeMP3Url" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarYoutubeMP3" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextYoutubeMP3Status" Text="Waiting for a link" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextYoutubeMP3Eta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonYoutubeMP3Cancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelYouTubeMP4" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="YouTube MP4" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Videos are saved in the MP4 Downloads folder" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="VIDEO URL" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,20">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP4Fetch" DockPanel.Dock="Right" Content="Find qualities"
                                    Style="{StaticResource PresetButtonStyle}" Padding="18,11" Margin="14,0,0,0"/>
                            <TextBox x:Name="TextYoutubeMP4Url" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="QUALITY" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ButtonYoutubeMP4Start" DockPanel.Dock="Right" Content="Download"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0" IsEnabled="False"/>
                            <!-- Populated by Find qualities; only the resolutions the video
                                 actually offers are listed. -->
                            <ComboBox x:Name="ComboYoutubeMP4Quality" Width="240" HorizontalAlignment="Left"
                                      IsEnabled="False"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ProgressBar x:Name="ProgressBarYoutubeMP4" Style="{StaticResource ProgressBarStyle}" Value="0"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="TextYoutubeMP4Status" Text="Waiting for a link" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextYoutubeMP4Eta" Text="--:--:--" FontFamily="{StaticResource FontData}"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="ButtonYoutubeMP4Cancel" Content="Cancel" Style="{StaticResource PresetButtonStyle}"
                                    HorizontalAlignment="Left" Width="100" Margin="0,16,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelSettings" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                    <TextBlock Text="Preferences are saved to assets/settings.json" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource FontData}" Margin="0,4,0,22"/>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Animations" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="The sliding nav highlight, hover effects and the drifting dropzone glow."
                                           FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           FontFamily="{StaticResource FontChrome}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="480"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="CheckShowAnimations" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" IsChecked="True"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource OptionCardBorderStyle}" Margin="0,0,0,26">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Look" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontChrome}"/>
                                <TextBlock Text="Midnight Gold is the original. Petalfall is ink, smoke and falling red petals."
                                           FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                           FontFamily="{StaticResource FontChrome}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="480"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TextLookHint" Text="" FontSize="11.5"
                                           Foreground="{StaticResource BrushGoldValue}" FontFamily="{StaticResource FontChrome}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ButtonLookGold" Content="Midnight Gold" Style="{StaticResource PresetButtonStyle}" Width="130"/>
                                <Button x:Name="ButtonLookPetalfall" Content="Petalfall" Style="{StaticResource PresetButtonStyle}" Width="110" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="TOOLS" Style="{StaticResource SectionLabelStyle}"/>
                    <Border Style="{StaticResource OptionCardBorderStyle}">
                        <!-- IsSharedSizeScope keeps the name/version/action columns aligned across the
                             three independent row Grids, whatever length version string a tool reports. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="ffmpeg and yt-dlp do the actual work. Keeping yt-dlp current is what stops YouTube links from failing."
                                       FontSize="12" Foreground="{StaticResource BrushTextBody}"
                                       FontFamily="{StaticResource FontChrome}" TextWrapping="Wrap"
                                       Margin="0,0,0,18" MaxWidth="560" HorizontalAlignment="Left"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolVersion"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ffmpeg" VerticalAlignment="Center" MinWidth="76"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextBody}"/>
                                <TextBlock Grid.Column="1" x:Name="TextToolVersionFfmpeg" Text="&#8212;"
                                           VerticalAlignment="Center" MinWidth="150" MaxWidth="260" Margin="0,0,18,0"
                                           FontFamily="{StaticResource FontData}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" x:Name="ButtonUpdateFfmpeg" Content="Checking&#8230;"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="164" IsEnabled="False" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" x:Name="TextToolPathFfmpeg" Text="&#8212;"
                                           VerticalAlignment="Center" Margin="22,0,0,0"
                                           HorizontalAlignment="Left" MaxWidth="430"
                                           FontFamily="{StaticResource FontData}" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolVersion"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ffprobe" VerticalAlignment="Center" MinWidth="76"
                                           FontFamily="{StaticResource FontChrome}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextBody}"/>
                                <TextBlock Grid.Column="1" x:Name="TextToolVersionFfprobe" Text="&#8212;"
                                           VerticalAlignment="Center" MinWidth="150" MaxWidth="260" Margin="0,0,18,0"
                                           FontFamily="{StaticResource FontData}" FontSize="11"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- No button by design: ffprobe is extracted from the same archive, so the
                                     ffmpeg button updates both. The label says so rather than leaving a gap. -->
                                <TextBlock Grid.Column="2" Text="ships with ffmpeg" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource FontChrome}" FontSize="11" FontStyle="Italic"
