<!-- src/assets/Theme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontChrome">Plus Jakarta Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="FontData">JetBrains Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="BrushShellBase" Color="#090D1A"/>

    <!-- Mesh/glow alphas are deliberately well above the "barely there" range: these sit
         under a BlurEffect and behind translucent panels, both of which wash out a subtle
         fill until it reads as flat grey rather than a tinted corner. -->
    <RadialGradientBrush x:Key="BrushGlowGold" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#59D3A24C" Offset="0"/>
        <GradientStop Color="#1FD3A24C" Offset="0.55"/>
        <GradientStop Color="#00D3A24C" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushGlowNavy" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#7A2B4D95" Offset="0"/>
        <GradientStop Color="#2E2B4D95" Offset="0.55"/>
        <GradientStop Color="#002B4D95" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushGlowPlum" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#6B5A3568" Offset="0"/>
        <GradientStop Color="#285A3568" Offset="0.55"/>
        <GradientStop Color="#005A3568" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushGlowDeepNavy" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#8A16224A" Offset="0"/>
        <GradientStop Color="#3516224A" Offset="0.55"/>
        <GradientStop Color="#0016224A" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#152C61" Offset="0"/>
        <GradientStop Color="#1F3F7A" Offset="0.5"/>
        <GradientStop Color="#D3A24C" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushBorderGold" Color="#2ED3A24C"/>
    <SolidColorBrush x:Key="BrushCardBackground" Color="#0C1626"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F2EDE0"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#8890B0"/>
    <!-- One step up from muted, for body copy that has to stay readable at 12px. -->
    <SolidColorBrush x:Key="BrushTextBody" Color="#AEB6D4"/>
    <SolidColorBrush x:Key="BrushGoldValue" Color="#E0C48F"/>
    <SolidColorBrush x:Key="BrushDropzoneFill" Color="#8C0F1830"/>

    <DropShadowEffect x:Key="EffectCardLift" Color="#000000" Opacity="0.45" BlurRadius="28" ShadowDepth="10" Direction="270"/>
    <DropShadowEffect x:Key="EffectGoldGlow" Color="#D3A24C" Opacity="0.45" BlurRadius="22" ShadowDepth="0"/>

    <!-- Nav icons. Stroked outlines rather than filled shapes: at 15px a filled glyph
         turns into a blob, and a stroke can inherit the item's Foreground so the icon
         brightens with its label on hover and selection. -->
    <Geometry x:Key="IconCompress">M8 1.5 L14.5 5 L8 8.5 L1.5 5 Z M1.5 8.5 L8 12 L14.5 8.5</Geometry>
    <Geometry x:Key="IconMergeAudio">M6 11.5 V2.5 L13.5 1 V10 M2.5 9.5 A1.9 1.9 0 1 0 2.5 13.3 A1.9 1.9 0 1 0 2.5 9.5 M10 8 A1.9 1.9 0 1 0 10 11.8 A1.9 1.9 0 1 0 10 8</Geometry>
    <!-- Scissors: crossed blades over two finger loops. -->
    <Geometry x:Key="IconTrim">M5.1 1.9 L10.6 10.1 M10.9 1.9 L5.4 10.1 M4.6 10.6 A1.85 1.85 0 1 0 4.6 14.3 A1.85 1.85 0 1 0 4.6 10.6 M11.4 10.6 A1.85 1.85 0 1 0 11.4 14.3 A1.85 1.85 0 1 0 11.4 10.6</Geometry>
    <!-- Mixer faders: two channels at different levels. Replaces the music note on
         Merge Audio, which moves to YouTube MP3. -->
    <Geometry x:Key="IconMixer">M3.5 2 V14 M12.5 2 V14 M1.7 6.2 H5.3 M10.7 10.4 H14.3</Geometry>
    <Geometry x:Key="IconVideo">M1.5 4 H10 V12 H1.5 Z M10 8 L14.5 5 V11 Z</Geometry>
    <!-- A cog: toothed rim plus a hub ring. The old one was a hub with spokes radiating
         out, which reads as a sun. -->
    <Geometry x:Key="IconSettings">M8 5.9 A2.1 2.1 0 1 0 8 10.1 A2.1 2.1 0 1 0 8 5.9 M8 1.2 V2.9 M8 13.1 V14.8 M14.8 8 H13.1 M2.9 8 H1.2 M12.8 3.2 L11.6 4.4 M4.4 11.6 L3.2 12.8 M12.8 12.8 L11.6 11.6 M4.4 4.4 L3.2 3.2 M8 3.4 A4.6 4.6 0 0 1 12.6 8 A4.6 4.6 0 0 1 8 12.6 A4.6 4.6 0 0 1 3.4 8 A4.6 4.6 0 0 1 8 3.4</Geometry>

    <!-- Sidebar items grow slightly and brighten on hover, and go bold + full-contrast
         when selected. They are RadioButtons so selection is mutually exclusive and
         IsChecked drives the active look directly; they still raise Click for wiring.
         The stock template is replaced outright; its hover state paints a light system
         highlight rectangle that is both off-theme and covers the gradient pill sliding
         behind it. Growth is anchored to the left edge so the list doesn't shift. -->
    <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Scaling is applied to the control itself, animated from Initialize-MainWindow
             rather than by a template EventTrigger. The hover effect is a dock-style
             magnification where the neighbours above and below shrink, and a template
             can only ever see the one item the mouse is actually over. -->
        <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <!-- After the hover trigger so selection wins when both apply. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FFF8EC"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon inside a nav item: stroke follows the item's Foreground so it tracks the
         hover and selected triggers above. -->
    <Style x:Key="NavIconStyle" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
    </Style>

    <!-- The "Convert to MP4" nav entry is permanently disabled in v1 (same as the
         console menu). Stock disabled chrome would grey it with system colors, so it
         gets its own muted-but-on-theme treatment. -->
    <Style x:Key="SidebarItemDisabledStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#565C78"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom template: the stock WPF button chrome repaints disabled/hover states
         with light system colors, which reads as a glaring white slab on this dark
         theme. The template keeps our brushes in every state. -->
    <Style x:Key="PresetButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#101B30"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#18264A"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gradient-border card technique: WPF lets BorderBrush itself be a gradient,
         so a single Border gives the thin gradient outline the spec calls for
         without layering a second inner panel. Kept to a hairline; at any real
         thickness the full navy-to-gold accent ramp reads as a loud outlined box
         rather than the restrained edge the spec asks for. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="#990C1626"/>
        <Setter Property="Padding" Value="22,20"/>
    </Style>

    <!-- The stock ProgressBar template paints a light track, a glossy overlay and a
         system-colored border, none of which survive contact with this theme. -->
    <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="9"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccentGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#0D1526" CornerRadius="5"
                            BorderBrush="#1FD3A24C" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quieter card variant for preset options: gold hairline instead of the full
         accent gradient, reserved for the actively-selected preset. -->
    <Style x:Key="OptionCardBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style x:Key="PresetCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGradient}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropzone glow: a soft ellipse that drifts left-right on a loop, per the
         spec's "slowly drifts left-right (~6s ease-in-out)" glassmorphism note.
         Self-targeting so the same style works inside any dropzone instance. -->
    <Style x:Key="DropzoneGlowStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="300"/>
        <Setter Property="Fill" Value="{StaticResource BrushGlowGold}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <BlurEffect Radius="45"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                            From="0" To="140" Duration="0:0:6"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Input controls below are implicit styles (no x:Key) so every panel, including
         the ones still to be built, picks them up automatically. Left to their stock
         templates, TextBox/ComboBox/RadioButton all paint themselves with light Windows
         system chrome and read as white slabs punched through the dark theme. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#101B30"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1F3F7A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#101B30"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{StaticResource BrushCardBackground}"
                                            BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1"
                                            CornerRadius="8">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource BrushGoldValue}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{StaticResource BrushTextPrimary}"/>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource BrushCardBackground}" CornerRadius="8" Margin="0,4,0,0"
                                    BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" Margin="4"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource BrushBorderGold}" StrokeThickness="1.4"
                                     Fill="{StaticResource BrushCardBackground}"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed"
                                     Fill="{StaticResource BrushGoldValue}"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Frosted glass. WPF has no backdrop-filter, and a VisualBrush of the layer behind
         would gain nothing here anyway: the background it would sample is a smooth
         gradient mesh, so blurring it returns very nearly the same pixels. The frosted
         read comes instead from the things a blur alone never gives you: a translucent
         fill that lets the mesh through, a white sheen falling top-to-bottom, and a
         light-catching top edge (the gradient BorderBrush below, bright at the top and
         fading to gold at the bottom), plus the drop shadow that lifts it off the page. -->
    <LinearGradientBrush x:Key="BrushGlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#17FFFFFF" Offset="0.4"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.75"/>
        <GradientStop Color="#14101B30" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8FFFFFFF" Offset="0"/>
        <GradientStop Color="#2ED3A24C" Offset="0.45"/>
        <GradientStop Color="#1FD3A24C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Specular top edge: a hairline of near-white along the very top of the glass,
         brightest at the left where the corner glow sits. This is the cue that most
         reads as "a pane of glass catching light" rather than a tinted rectangle. -->
    <LinearGradientBrush x:Key="BrushGlassSpecular" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#A6FFFFFF" Offset="0.22"/>
        <GradientStop Color="#40FFFFFF" Offset="0.6"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushGlassDash" Color="#82D3A24C"/>

    <LinearGradientBrush x:Key="BrushGlassFillHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0"/>
        <GradientStop Color="#24FFFFFF" Offset="0.4"/>
        <GradientStop Color="#17FFFFFF" Offset="0.75"/>
        <GradientStop Color="#1C101B30" Offset="1"/>
    </LinearGradientBrush>

    <!-- The whole dropzone is the button, not just the "Browse" chip inside it: the
         entire panel is the drop target, so the entire panel should be the click target
         too. The chip is a plain Border here; a nested Button would only create a
         smaller competing hit area inside its own parent. -->
    <Style x:Key="DropzoneButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="200"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- A Rectangle rather than a Border: Border has no dashed-stroke
                             option, and the dash is what makes this read as a drop target
                             on sight instead of as another card. -->
                        <!-- Solid stroke colour, not the vertical BrushGlassEdge gradient
                             used elsewhere: that gradient fades to near-transparent down
                             the sides, which erases most of the dashes. -->
                        <Rectangle x:Name="Glass" RadiusX="14" RadiusY="14"
                                   Fill="{StaticResource BrushGlassFill}"
                                   Stroke="{StaticResource BrushGlassDash}" StrokeThickness="1.7"
                                   StrokeDashArray="4 3" StrokeDashCap="Round"
                                   Effect="{StaticResource EffectCardLift}"/>
                        <Grid ClipToBounds="True">
                            <!-- Canvas reports no desired size, so the oversized glow
                                 paints over the dropzone without inflating its height. -->
                            <Canvas>
                                <Ellipse Style="{StaticResource DropzoneGlowStyle}" Canvas.Left="-60" Canvas.Top="-130"/>
                            </Canvas>
                        </Grid>
                        <ContentPresenter x:Name="DropContent" Margin="26,24"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glass" Property="Fill" Value="{StaticResource BrushGlassFillHover}"/>
                            <Setter TargetName="Glass" Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                        <!-- Without this a locked dropzone looks identical to a live one,
                             so the only clue it is refusing input is that nothing happens.
                             The content is dimmed as well as the panel behind it: the gold
                             "Browse Files" chip sits on top and, left at full strength, goes
                             on reading as the most clickable thing on the screen while the
                             dropzone silently swallows every click. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glass" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Glass" Property="Stroke" Value="{StaticResource BrushTextMuted}"/>
                            <Setter TargetName="DropContent" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The call to action inside the dropzone. Deliberately not a Button: the whole
         dropzone already handles the click, and a real Button here would just carve a
         competing hit area out of its own parent. -->
    <Style x:Key="DropzoneChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushAccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="26,11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource EffectGoldGlow}"/>
    </Style>

    <!-- Cloud with a down arrow: the conventional "drop things here" mark. -->
    <Geometry x:Key="IconDropCloud">M7.5 15.5 A4.2 4.2 0 0 1 8 7.2 A5.8 5.8 0 0 1 19.3 7.6 A4 4 0 0 1 19 15.5 Z M13.4 14 V23 M9.9 19.5 L13.4 23 L16.9 19.5</Geometry>

    <Style x:Key="DropCloudIconStyle" TargetType="Path">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- The one affirmative action on a screen (Download, Merge, Trim). Carries the accent
         gradient so it is distinguishable at a glance from Cancel and the neutral
         secondary buttons, which share PresetButtonStyle's dark fill. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#FFF8EC"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="24,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="8" Background="{StaticResource BrushAccentGradient}"/>
                        <Border x:Name="Sheen" CornerRadius="8" Background="#00FFFFFF"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sheen" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="Fill" Property="Effect" Value="{StaticResource EffectGoldGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Sheen" Property="Background" Value="#26000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Export sits in a row of same-sized secondary buttons (Split / Delete / Undo), where
         the plain accent gradient of PrimaryButtonStyle still reads as "one more button".
         This variant carries the gold glow permanently rather than only on hover, plus a
         lighter inner sheen and more weight, so the one action that produces a file is
         obvious without hovering. Separate from PrimaryButtonStyle on purpose: a glow on
         every affirmative button in the app would cancel itself out. -->
    <Style x:Key="HeroButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="30,13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="9" Background="{StaticResource BrushAccentGradient}"
                                Effect="{StaticResource EffectGoldGlow}"/>
                        <Border x:Name="Sheen" CornerRadius="9" Background="#14FFFFFF"/>
                        <Border x:Name="Edge" CornerRadius="9" BorderThickness="1" BorderBrush="#59FFE9C4"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sheen" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Sheen" Property="Background" Value="#26000000"/>
                        </Trigger>
                        <!-- The glow has to go when disabled: a glowing button that does
                             nothing on click reads as broken rather than as unavailable. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                            <Setter TargetName="Fill" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="Edge" Property="BorderBrush" Value="#00000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bipolar gain slider for the merge panel. The stock ProgressBar/Slider chrome is
         light-themed and system-colored, same problem the ProgressBar template solves.
         The centre notch is a fixed 50% marker rather than a tick collection: the range
         is symmetric (-20..+20 dB), so unity gain is always dead centre, and a notch
         there is what makes "negative" legible as "quieter than the original". -->
    <Style x:Key="GainSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="-20"/>
        <Setter Property="Maximum" Value="20"/>
        <Setter Property="Value" Value="0"/>
        <Setter Property="SmallChange" Value="0.5"/>
        <Setter Property="LargeChange" Value="3"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="0.5"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                Background="#0D1526" BorderBrush="#1FD3A24C" BorderThickness="1"/>
                        <Border Width="1" Height="11" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Background="#4DD3A24C"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Grip" Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="{StaticResource BrushAccentGradient}"
                                                     Stroke="#66FFE9C4" StrokeThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Effect"
                                                            Value="{StaticResource EffectGoldGlow}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings uses a real switch rather than a tick box, per the design spec. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="48" Height="27" CornerRadius="13.5"
                                Background="#0D1526" BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1">
                            <!-- The knob is positioned by a transform, not by swapping
                                 HorizontalAlignment/Margin on check: neither of those is
                                 animatable, which is why it used to jump. -->
                            <Ellipse x:Name="Knob" Width="19" Height="19" HorizontalAlignment="Left"
                                     Margin="3,0,0,0" Fill="{StaticResource BrushTextMuted}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Only the colours change here. The knob's travel is animated from
                             code (Register-ToggleSwitch in Video-Audio-Tool.ps1), not by a
                             storyboard in this trigger: this dictionary gets merged into
                             Application.Resources, which freezes it, and a storyboard whose
                             Duration is a DynamicResource cannot be frozen. Driving it from
                             code also lets it read the Animations setting directly, the same
                             way the nav pill already works. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccentGradient}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="#FFF8EC"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim dark scrollbar. The stock one is a light grey slab with stepper buttons,
         which is jarring against this theme; content can exceed the window height once
         the GPU card appears or the window is resized down. -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="#3AD3A24C" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#7AD3A24C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <!-- Page-up/down still work; they just have no visible buttons. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="Margin" Value="2,0,0,10"/>
    </Style>

    <!-- Preset options are RadioButtons, not Buttons: selection is mutually exclusive and
         IsChecked drives the selected visual for free. They still raise Click, so the
         planned Task 10 wiring is unaffected. -->
    <Style x:Key="PresetCardStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Card" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource BrushBorderGold}"
                                Background="{StaticResource BrushCardBackground}"/>
                        <Border x:Name="SelectedFill" CornerRadius="11" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                                    <GradientStop Color="#4CD3A24C" Offset="0"/>
                                    <GradientStop Color="#141F3F7A" Offset="0.55"/>
                                    <GradientStop Color="#000C1626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="18,16"/>
                        <Grid x:Name="CheckBadge" Width="20" Height="20" Opacity="0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F0C87A" Offset="0"/>
                                        <GradientStop Color="#D3A24C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Data="M 0 3.5 L 3 6.5 L 8.5 1" Stroke="#0A0E1A" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                        <!-- SelectedFill and CheckBadge are faded from code
                             (Move-PresetHighlight in Video-Audio-Tool.ps1) rather than
                             snapped here, for the same reason the toggle knob is: a
                             storyboard in this dictionary cannot be frozen once it is
                             merged into Application.Resources, and it could not read the
                             Animations setting anyway. The card's own border is left off
                             the checked state entirely, because the travelling outline in
                             MainWindow.xaml draws it; having both would put two gold
                             outlines on screen during every transition. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The selected-video card: thumbnail left, labelled rows right. One template
         shared by Compress, Merge Audio and Trim; the panels supply only a name.
         Populated from code via Template.FindName, so every child that code touches
         carries a PART_ name. -->
    <Style x:Key="VideoCardStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="10" BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorderGold}"
                            Background="{StaticResource BrushCardBackground}"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="168" Height="95">
                                <Border x:Name="PART_Placeholder" CornerRadius="8"
                                        Background="#101B30" BorderThickness="1"
                                        BorderBrush="{StaticResource BrushBorderGold}">
                                    <Path Data="{StaticResource IconVideo}" Stretch="Uniform"
                                          Width="26" Height="26" Opacity="0.35"
                                          Stroke="{StaticResource BrushTextMuted}" StrokeThickness="1.2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Clipped to the same radius as the placeholder so the
                                     photo does not sit in a square hole in a rounded card.
                                     An explicit geometry, not a rounded Border: a Border's
                                     CornerRadius does not clip its child, and ClipToBounds
                                     clips to the square bounds, so both leave hard corners.
                                     The rect is safe to hardcode because the slot around it
                                     is a fixed 168x95. -->
                                <Image x:Name="PART_Thumb" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,168,95" RadiusX="8" RadiusY="8"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_Name" FontSize="14.5" FontWeight="SemiBold"
                                           FontFamily="{StaticResource FontChrome}"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" FontSize="11"
                                               FontFamily="{StaticResource FontChrome}"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="PART_Resolution" FontSize="12.5"
                                               FontFamily="{StaticResource FontData}"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame rate" FontSize="11"
                                               FontFamily="{StaticResource FontChrome}"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PART_FrameRate" FontSize="12.5"
                                               FontFamily="{StaticResource FontData}"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Length" FontSize="11"
                                               FontFamily="{StaticResource FontChrome}"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PART_Length" FontSize="12.5"
                                               FontFamily="{StaticResource FontData}"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Size" FontSize="11"
                                               FontFamily="{StaticResource FontChrome}"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="PART_Size" FontSize="12.5"
                                               FontFamily="{StaticResource FontData}"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recent files list. Sits under each dropzone as an alternative to browsing;
         the rows themselves are built in Video-Audio-Tool.ps1 rather than declared,
         so the design lives here in one place instead of nine times in MainWindow. -->
    <Style x:Key="RecentCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="Padding" Value="12,11"/>
    </Style>

    <Style x:Key="RecentLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontChrome}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="4,0,0,8"/>
    </Style>

    <!-- Templated down to nothing so a row reads as a list item, not a button. The
         hover tint is the only affordance, which is why Cursor is set as well. -->
    <Style x:Key="RecentRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowFill" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowFill" Property="Background" Value="#1FD3A24C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately the same construction as the DETECTED chip on the GPU card
         (MainWindow.xaml): tinted fill, hairline border, 9 radius, 7,1.5 padding.
         A solid gold fill was tried first and read as a heavy blob next to the
         muted row text, louder than anything else on the panel. -->
    <Style x:Key="RecentPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AD3A24C"/>
        <Setter Property="BorderBrush" Value="#5CD3A24C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,1.5"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Trim editor. The timeline is drawn in code from the cut list, so these styles
         describe one piece, one cut line and the playhead rather than a whole control. -->
    <Style x:Key="TimelineTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="#0A1120"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TimelinePieceStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#1F3F7A"/>
        <Setter Property="Stroke" Value="#2E2B4D95"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="TimelinePieceSelectedStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#3DD3A24C"/>
        <Setter Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>

    <!-- Marks an existing cut boundary. Gold, matching the Split/selection accent
         elsewhere in this panel, and deliberately thinner than the playhead so the two
         are never mistaken for each other at a glance. -->
    <Style x:Key="TimelineCutLineStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="Width" Value="1.5"/>
    </Style>

    <!-- Current position, and where S will cut. Bright cyan, not used anywhere
         else in this panel, so it never reads as "just another gold cut line". -->
    <Style x:Key="TimelinePlayheadStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#6FD8FF"/>
        <Setter Property="Width" Value="3"/>
    </Style>

    <!-- Grip and time badge that ride the playhead. Same cyan as the playhead line so
         the three read as one object: a hairline alone is easy to lose against the
         filmstrip, and the line by itself never says WHERE it is. -->
    <Style x:Key="TimelinePlayheadGripStyle" TargetType="Polygon">
        <Setter Property="Fill" Value="#6FD8FF"/>
    </Style>

    <Style x:Key="TimelinePlayheadBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#6FD8FF"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="5,1"/>
    </Style>

    <!-- Dark text on the cyan fill: muted-grey ruler text on this background is
         unreadable, and the badge has to stay legible at a glance while playing. -->
    <Style x:Key="TimelinePlayheadBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#06121F"/>
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Fade toggle sitting under a cut. Off is a hollow outline, on is filled cyan: the
         same cyan as the playhead, because both mark "something happens here" as opposed
         to the gold that marks a cut boundary itself. -->
    <Style x:Key="TimelineFadeToggleStyle" TargetType="Border">
        <!-- Reads as a button rather than a caption: a lit fill instead of the panel's own
             background, a border solid enough to see against the dark card, and enough
             padding that the hit target is a comfortable click rather than a 9px word. -->
        <Setter Property="Background" Value="#1B2E47"/>
        <Setter Property="BorderBrush" Value="#8C6FD8FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="13,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#27435F"/>
                <Setter Property="BorderBrush" Value="#6FD8FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TimelineFadeToggleOnStyle" TargetType="Border" BasedOn="{StaticResource TimelineFadeToggleStyle}">
        <Setter Property="Background" Value="#6FD8FF"/>
        <Setter Property="BorderBrush" Value="#6FD8FF"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#95E4FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TimelineFadeToggleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#9FE6FF"/>
    </Style>

    <!-- Hairline from the cut down to its toggle. With the toggles in their own row there
         is otherwise nothing tying a pill to the cut it belongs to, which matters as soon
         as there is more than one. -->
    <Style x:Key="TimelineFadeStemStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#596FD8FF"/>
        <Setter Property="Width" Value="1"/>
    </Style>

    <Style x:Key="TimelineFadeToggleTextOnStyle" TargetType="TextBlock" BasedOn="{StaticResource TimelineFadeToggleTextStyle}">
        <Setter Property="Foreground" Value="#06121F"/>
    </Style>

    <!-- Caption blocks on their lane: gold family, distinct from the blue video
         pieces, with visible edge grips for retiming. -->
    <Style x:Key="CaptionBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="#4D6B5320"/>
        <Setter Property="BorderBrush" Value="#B3D3A24C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Cursor" Value="SizeAll"/>
    </Style>
    <Style x:Key="CaptionBlockSelectedStyle" TargetType="Border" BasedOn="{StaticResource CaptionBlockStyle}">
        <Setter Property="Background" Value="#806B5320"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style x:Key="CaptionBlockTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Track lane row (Task 8): one per track in the multi-track stack, header on the
         left and a span-bar canvas on the right. Darker and flatter than the caption/zoom
         lanes above it, since this row is a list of tracks, not a strip of time. -->
    <Style x:Key="TrackLaneStyle" TargetType="Border">
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#CC0A0F1C"/>
        <Setter Property="BorderBrush" Value="#2A3B52"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="TrackChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#8FA8C0"/>
    </Style>

    <!-- Sidebar field label + row spacing for the caption properties column. -->
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>

    <!-- Small segmented picker for the fade length. Selection is set from code by
         swapping to the "selected" variant, the same approach the timeline pieces use. -->
    <Style x:Key="FadeLengthButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" CornerRadius="6" Background="#0D1526"
                            BorderBrush="#1FD3A24C" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#59D3A24C"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Shell" Property="Background" Value="#1FD3A24C"/>
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushGoldValue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption colour palette swatch. The template honours the button's own Background,
         which is the colour itself, set from code when the palette is built. -->
    <Style x:Key="CaptionSwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Swatch" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#33FFFFFF" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource BrushBorderGold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TimelineRulerTickStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- Zoom keyframe lane: diamonds mark keyframes, ramps show the
         transition shape between adjacent keyframes. The spotlight box and
         dim rects drawn on the preview overlay while editing a zoom are
         painted from code with raw brushes, not styles, since their size
         and position are fully data driven. -->
    <Style x:Key="ZoomDiamondStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Fill" Value="#B08CFF"/>
        <Setter Property="Stroke" Value="#06121F"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZoomDiamondSelectedStyle" TargetType="Rectangle" BasedOn="{StaticResource ZoomDiamondStyle}">
        <Setter Property="Stroke" Value="{StaticResource BrushGoldValue}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#B08CFF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZoomRampStyle" TargetType="Rectangle">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00B08CFF" Offset="0"/>
                    <GradientStop Color="#73B08CFF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZoomRampDownStyle" TargetType="Rectangle">
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#73B08CFF" Offset="0"/>
                    <GradientStop Color="#00B08CFF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZoomRampHoldStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#4DB08CFF"/>
    </Style>

    <Style x:Key="ZoomPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#F2090D1A"/>
        <Setter Property="BorderBrush" Value="#80B08CFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="ZoomPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#D8C7FF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Greyed shortcut letter beside a button label. -->
    <Style x:Key="ShortcutHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontData}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
